{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ap-leak-finder-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5174,
      "env": { "RECLAIM_API_ORIGIN": "http://localhost:8787" }
    },
    {
      "name": "api-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:server"],
      "port": 8787
    },
    {
      "name": "landing-site",
      "runtimeExecutable": "node",
      "runtimeArgs": ["landing-site/serve.cjs"],
      "port": 5520,
      "autoPort": true
    }
  ]
}
