{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ap-leak-finder-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5174
    },
    {
      "name": "reclaim-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:server"
      ],
      "port": 8790
    },
    {
      "name": "landing-site",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "landing-site/serve.cjs"
      ],
      "port": 5520,
      "autoPort": true
    },
    {
      "name": "onboarding-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5181",
        "--strictPort"
      ],
      "port": 5181
    },
    {
      "name": "onboarding-review",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--config",
        "vite.onboarding-demo.config.ts",
        "--port",
        "5182",
        "--strictPort"
      ],
      "port": 5182
    }
  ]
}
