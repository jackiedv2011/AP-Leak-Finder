# Docker matches these from the build-context root; `**/` means at any depth.
# Secrets and data never enter the build context, so they can never reach a layer.
**/.env
**/.env.*
!.env.example
**/*.local
data
**/*.sqlite
**/*.sqlite-*
**/*.db
backups

# Rebuilt inside the image
**/node_modules
dist
demo-dist
dist-ssr

# Not needed to build or run
.git
.claude
.vscode
.idea
**/.DS_Store
.sync_removed
**/*.log
**/*.MOV
**/*.mov
landing-site/blender
landing-site/notes
demo
plans
docs
scripts/qbo-sandbox
.reclaim-test-results.json
Dockerfile
.dockerignore
