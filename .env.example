# Reclaim server configuration. Copy to `.env` (never commit `.env`).
# Everything here is read by server/config.ts. Nothing in this file is ever
# shipped to the browser; the client only learns which features are on via
# GET /api/auth/providers.

# ---- required in production ----
# NODE_ENV=production            # turns on Secure cookies and static serving of dist/
# APP_ORIGIN=https://app.example.com   # public URL of the app; used in email links and the Google redirect URI (must be https in production)
# DATABASE_PATH=./data/reclaim.sqlite  # SQLite file (default). Back it up; it holds every account and audit.
PORT=8787

# ---- accounts ----
# REQUIRE_EMAIL_VERIFICATION=true   # default true. `false` only for local demos.
# SESSION_DAYS=1                    # session length without "keep me logged in"
# REMEMBER_ME_DAYS=30               # with it

# ---- email delivery (Resend). Without both, the dev mailbox is used and no email is sent. ----
# RESEND_API_KEY=re_xxx             # SECRET
# EMAIL_FROM="Reclaim <no-reply@example.com>"
# Or, without a domain: send from a Gmail account with a Google app password
# (Google Account > Security > 2-Step Verification > App passwords). Used when Resend is not set.
# GMAIL_USER=reclaimbusiness1@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx   # SECRET
# Where the website's contact form is delivered (default reclaimbusiness1@gmail.com).
# CONTACT_EMAIL=reclaimbusiness1@gmail.com

# ---- Google sign-in (identity only: openid email profile). Both empty = button hidden. ----
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com   # public identifier
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx                     # SECRET — server only, never in src/
# Send approved recovery requests from the customer's own Gmail (gmail.send only;
# same Google client as sign-in). Needs the Gmail API, the redirect URI and the
# scope set up in Google Cloud: docs/deploy.md §4a. 32 random bytes:
# GMAIL_TOKEN_KEY=$(openssl rand -base64 32)          # SECRET

# ---- AI drafting of recovery letters. Empty = "Draft with AI" reports itself unavailable. ----
# ANTHROPIC_API_KEY=sk-ant-xxxx     # SECRET — server only
# ANTHROPIC_MODEL=claude-opus-5

# ---- development ----
# DEV_MAILBOX=true                  # default on outside production: GET /api/dev/mailbox?to=... shows mail the server would have sent

# Stripe (checkout). The publishable key is public by design; the secret key must
# never go in a VITE_ variable. Without it, checkout runs on Stripe's demo test key.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# QuickBooks Online — sandbox only, read-only (server/quickbooks.ts).
# Keys from developer.intuit.com → your app → Keys and credentials (Development).
# Add this redirect URI there: <APP_ORIGIN>/api/integrations/quickbooks/callback
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32). Seals stored tokens; never commit it.
QBO_TOKEN_KEY=
